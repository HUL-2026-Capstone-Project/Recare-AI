# 이 파일을 .env로 복사한 뒤 값을 채우세요 (.env는 git에 올라가지 않습니다)
OPENAI_API_KEY=sk-여기에_발급받은_키

# 국가법령정보 OPEN API 인증키(OC). open.law.go.kr에서 발급, 판례·재결례 수집에 사용
LAW_OC=여기에_발급받은_인증키

# 선택: 임베딩 모델을 바꾸면 build_vector_db.py로 벡터 DB를 다시 만들어야 합니다
# EMBEDDING_MODEL=text-embedding-3-large

# 선택: 설정하면 대화 세션을 Redis에 저장 (여러 워커로 띄울 때 필요)
# REDIS_URL=redis://localhost:6379/0
